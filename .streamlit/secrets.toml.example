# Copy to .streamlit/secrets.toml for local `streamlit run`, or paste into
# Streamlit Cloud -> App -> Settings -> Secrets. NEVER commit secrets.toml.
LLM_BACKEND = "claude"            # claude | deepseek
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-opus-4-8"
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"
LLM_MAX_TOKENS = "32000"
APP_PASSWORD = ""                  # set this: a public app spends your API credits
